# ── Server Ports on MintBox ────────────────────────────────────────────────
PORT=8080
HOST_FRONTEND_PORT=5174
HOST_API_PORT=8080
HOST_DB_PORT=5435
HOST_REDIS_PORT=6379
HOST_TEMPORAL_UI_PORT=8088

# ── Database ─────────────────────────────────────────────────────────────────
DB_USER=chainnode
DB_PASSWORD=chainnode_secret
DB_NAME=chainnode

# ── Auth & Admin ─────────────────────────────────────────────────────────────
JWT_SECRET=dev-insecure-secret-change-in-prod
ADMIN_USERNAME=admin
ADMIN_PASSWORD=pwd
CORS_ORIGINS=*

# ── LLM Providers (Add keys as needed) ───────────────────────────────────────
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_MODEL=

# ── Cloudflare Tunnel (Set when ready for remote access) ─────────────────────
CLOUDFLARE_TUNNEL_TOKEN=

