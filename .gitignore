# Local config — never commit
.env

# Go build artifacts — compiled binaries at repo root and in bin/
bin/
*.exe
*.test
/server
/worker
/specialist-worker
/specialist-worker-template
.cache/

# Frontend
frontend/node_modules/
frontend/dist/

# Temporal local state — the dynamicconfig file IS committed (required for startup)
